# Copy to .env and fill in. .env is gitignored: never commit it, because this repo is public. Foundry loads .env for
# every forge command run from the repo root.

# The backend's Alchemy key: AlchemyApp.Misc, Development/Local, in the backend's
# Common/Common.Nethereum/Services/Singletons/AlchemyUrlProvider.cs. script/Networks.sol builds the RPC from it.
ALCHEMY_KEY=

# The beacon's deploying key, the same on Sepolia and Ethereum mainnet. It owns the beacon it deploys.
DEPLOYER_PRIVATE_KEY=
